# Database
DATABASE_URL="postgresql://user:password@localhost:5432/tama_fashion"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication (NextAuth.js)
AUTH_SECRET="your-secret-key-here-min-32-chars"
AUTH_TRUST_HOST="true"

# Email Configuration (for notifications)
EMAIL_FROM="noreply@tamafashion.com"
EMAIL_PROVIDER="sendgrid" # or another provider
EMAIL_API_KEY="your-email-api-key"

# Image Storage (Cloudinary, AWS S3, etc.)
NEXT_PUBLIC_IMAGE_URL="https://your-image-storage.com"
IMAGE_API_KEY="your-image-api-key"

# Payment Gateway Configuration
# Future integrations for Nepal payment providers
PAYMENT_PROVIDER="cash_on_delivery" # esewa, khalti, imepay, fonepay
PAYMENT_API_KEY=""
PAYMENT_SECRET_KEY=""

# Admin Settings
ADMIN_EMAIL="admin@tamafashion.com"

# Node Environment
NODE_ENV="development"
